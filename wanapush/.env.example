# WanaPush — variables d'environnement
# Copier ce fichier vers .env.local et remplir les valeurs.
# .env.local n'est PAS commité (cf .gitignore).

# ──────────────────────────────────────────────────────────────────────────
# Base de données — MariaDB / MySQL
# ──────────────────────────────────────────────────────────────────────────

# DB principale (Prisma migrate + runtime)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/wanapush"

# Shadow DB pour `prisma migrate dev` (une autre DB vide accessible avec les
# mêmes credentials). Pas nécessaire en prod.
SHADOW_DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/wanapush_shadow"

# ──────────────────────────────────────────────────────────────────────────
# Auth (NextAuth.js)
# ──────────────────────────────────────────────────────────────────────────

NEXTAUTH_SECRET="<openssl rand -hex 32>"
NEXTAUTH_URL="https://wanapush.com"
NEXT_PUBLIC_BASE_URL="https://wanapush.com"

# Connexion Google (compte user — pas pour GBP)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ──────────────────────────────────────────────────────────────────────────
# Sécurité — chiffrement des tokens en BDD (AES-256-GCM)
# ──────────────────────────────────────────────────────────────────────────

# 32 bytes hex (64 chars). Générer : openssl rand -hex 32
# ⚠️ NE JAMAIS changer cette clé en prod : les tokens existants deviendraient
# illisibles. Pour rotation, prévoir un script de re-chiffrement.
ENCRYPTION_KEY=""

# ──────────────────────────────────────────────────────────────────────────
# Cron (endpoints /api/*/cron/* protégés par ce header)
# ──────────────────────────────────────────────────────────────────────────

CRON_SECRET="<openssl rand -hex 32>"

# ──────────────────────────────────────────────────────────────────────────
# IA — Claude (principal) + OpenAI (fallback / image)
# ──────────────────────────────────────────────────────────────────────────

AI_PROVIDER="anthropic"  # anthropic | openai
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"
OPENAI_IMAGE_MODEL="gpt-image-1"

# ──────────────────────────────────────────────────────────────────────────
# Réseaux sociaux — OAuth apps
# ──────────────────────────────────────────────────────────────────────────

META_APP_ID=""
META_APP_SECRET=""
META_LOGIN_CONFIG_ID=""    # ID Facebook Login for Business (optionnel)

# Instagram = sub-app dédiée
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""

LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# ──────────────────────────────────────────────────────────────────────────
# Publicité payante — OAuth apps Ads Managers
# ──────────────────────────────────────────────────────────────────────────

GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

TIKTOK_ADS_APP_ID=""
TIKTOK_ADS_APP_SECRET=""

LINKEDIN_ADS_CLIENT_ID=""
LINKEDIN_ADS_CLIENT_SECRET=""

# Meta Ads partage META_APP_ID/SECRET ci-dessus.

# ──────────────────────────────────────────────────────────────────────────
# Stripe (Shop e-commerce + storefront paiement)
# ──────────────────────────────────────────────────────────────────────────

STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ──────────────────────────────────────────────────────────────────────────
# Emails transactionnels (Shop confirmations + futur Email marketing)
# ──────────────────────────────────────────────────────────────────────────

RESEND_API_KEY="re_..."

# ──────────────────────────────────────────────────────────────────────────
# Storage — S3 / R2 (uploads users, à terme remplacer public/uploads local)
# ──────────────────────────────────────────────────────────────────────────

AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
AWS_REGION="eu-west-1"

# ──────────────────────────────────────────────────────────────────────────
# Outils tiers
# ──────────────────────────────────────────────────────────────────────────

# PageSpeed Insights API (audit SEO)
GOOGLE_PSI_API_KEY=""

# Unsplash (images stock pour Site Generator)
UNSPLASH_ACCESS_KEY=""

# ──────────────────────────────────────────────────────────────────────────
# Cache / rate-limit distribué (optionnel — fallback in-memory si vide)
# ──────────────────────────────────────────────────────────────────────────

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
